<Window x:Class="SeaBattle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SeaBattle"
        mc:Ignorable="d"
        Title="SeaBattle" Height="450" Width="900">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Игра">
                <MenuItem Header="Создать сервер"        Click="CreateServer_Click"/>
                <MenuItem Header="Подключиться к серверу" Click="ConnectToServer_Click"/>
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <local:BoardControl x:Name="boardPlayer" Grid.Column="0"/>
            <local:BoardControl x:Name="boardEnemy"  Grid.Column="1"/>

            <StackPanel Grid.Column="2" Margin="10">
                <GroupBox Header="Размещение кораблей">
                    <StackPanel>
                        <ListBox x:Name="lstShips" Height="120" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="btnRotate" Click="BtnRotate_Click" Margin="0,0,6,0">Ориентация: Гор.</Button>
                            <Button x:Name="btnClear" Click="BtnClear_Click" Margin="0,0,6,0">Очистить</Button>
                            <Button x:Name="btnReady" Click="BtnReady_Click">Готов</Button>
                        </StackPanel>
                        <TextBlock Text="ЛКМ — поставить; ПКМ — удалить" FontStyle="Italic" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>

                <local:StatusPanel  x:Name="statusPanel" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
