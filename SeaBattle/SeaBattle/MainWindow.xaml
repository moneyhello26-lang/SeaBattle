<Window x:Class="SeaBattle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SeaBattle"
        mc:Ignorable="d"
        Title="SeaBattle" Height="450" Width="900">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Игра">
                <MenuItem Header="Создать сервер"        Click="CreateServer_Click"/>
                <MenuItem Header="Подключиться к серверу" Click="ConnectToServer_Click"/>
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <local:BoardControl x:Name="boardPlayer" Grid.Column="0" Margin="10"/>
            <local:BoardControl x:Name="boardEnemy"  Grid.Column="1" Margin="10"/>
            <local:StatusPanel  x:Name="statusPanel" Grid.Column="2" Margin="10"/>
        </Grid>
    </DockPanel>
</Window>
